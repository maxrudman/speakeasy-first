# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Postgres connection string.
# Easiest: create a free database at https://neon.tech (or through Vercel → Storage → Neon)
# and paste the *pooled* connection string here.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 32 characters, used to sign login sessions.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Optional. Without it the app uses its built-in word and question lists.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Claude model tried first for terms, questions and the coach.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Comma-separated Claude models to try next if the first one fails.
ANTHROPIC_MODEL_FALLBACKS=claude-haiku-5-5
# Optional. If OPENAI_API_KEY (below) is set, OpenAI is tried after the Claude models.
OPENAI_MODEL=
# Optional. Point OpenAI calls at a proxy or test server.
OPENAI_BASE_URL=
# Optional. "1" skips every AI provider and uses the built-in lists (no API cost; good for demos and tests).
SPEAKEASY_MOCK_AI=

# ---------------------------------------------------------------------------
# Transcription backups (all optional). The app tries, in order:
#   1. the browser's live speech recognition (no key needed)
#   2. OpenAI Whisper          (OPENAI_API_KEY)
#   3. Deepgram, then AssemblyAI (DEEPGRAM_API_KEY, ASSEMBLYAI_API_KEY)
#   4. a box where the user types or pastes their answer
# Any tier without a key is skipped. Audio is sent in memory and never stored.
OPENAI_API_KEY=
# Optional. Defaults to whisper-1.
OPENAI_TRANSCRIBE_MODEL=
DEEPGRAM_API_KEY=
# Optional. Defaults to nova-3.
DEEPGRAM_MODEL=
ASSEMBLYAI_API_KEY=
# Testing only: "1" returns a fixed sample transcript. Leave empty in production.
SPEAKEASY_MOCK_TRANSCRIPTION=

# ---------------------------------------------------------------------------
# Reminders (all optional; each feature turns itself off without its keys)
# Public URL used in reminder emails and notifications, e.g. https://speakeasy-first.vercel.app
APP_URL=
# Email reminders: set EMAIL_FROM plus ONE of the two provider keys.
# EMAIL_FROM must be an address on a domain you verified with the provider, e.g. "Speak Ready <reminders@yourdomain.com>"
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=
# Vercel Cron calls /api/cron/reminders daily (see vercel.json) with "Authorization: Bearer $CRON_SECRET".
# Any long random string. Without it, scheduled reminders are off.
CRON_SECRET=
# Web Push. Generate a key pair once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:team@yourdomain.com
VAPID_SUBJECT=
