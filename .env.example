# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Postgres connection string.
# Easiest: create a free database at https://neon.tech (or through Vercel → Storage → Neon)
# and paste the *pooled* connection string here.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, at least 32 characters, used to sign login sessions.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# AI features (tailored vocabulary, setting-specific questions, speech feedback).
# Set ONE of these. Without either, the app uses built-in lists and a basic grader.

# Free: Groq, no credit card. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Groq model to use.
GROQ_MODEL=openai/gpt-oss-120b

# Paid: Claude. Used instead of Groq when set. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Claude model to use.
ANTHROPIC_MODEL=claude-sonnet-5-5
